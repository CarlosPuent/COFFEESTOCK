# =====================================================================
#  CoffeeStock - configuración local
#  Copia este archivo como ".env" (en la misma carpeta que manage.py)
#  y cambia solo lo que necesites. Las líneas con # son comentarios.
#  No pongas comillas ni espacios alrededor del "=".
# =====================================================================


# ---------------------------------------------------------------------
#  1. BASE DE DATOS (SQL Server)
# ---------------------------------------------------------------------

DB_NAME=CoffeeStockDB

# Nombre del servidor, exactamente como aparece en "Server name" al
# conectarte con SQL Server Management Studio. Ejemplos:
#   localhost\SQLEXPRESS        -> SQL Server Express (lo más común)
#   localhost                   -> Developer/Standard, o Docker
#   (localdb)\MSSQLLocalDB      -> LocalDB (viene con Visual Studio)
#   MI-PC\SQLEXPRESS            -> usando el nombre del equipo
DB_HOST=localhost\SQLEXPRESS

# Déjalo vacío salvo que uses Docker o un puerto fijo (ej. 1433).
DB_PORT=

# Autenticación:
#   Windows Authentication -> deja DB_USER y DB_PASSWORD vacíos.
#   SQL Authentication     -> llena ambos (ej. sa, o el usuario
#                             coffeestock_app que crea scripts/crear_base_de_datos.sql).
DB_USER=
DB_PASSWORD=

# Opcional. Se detecta solo (usa el 18 o el 17, el que tengas instalado).
# DB_DRIVER=ODBC Driver 18 for SQL Server


# ---------------------------------------------------------------------
#  2. ALERTAS DE STOCK BAJO POR CORREO
# ---------------------------------------------------------------------

# A QUIÉN le llegan las alertas. Pon aquí tu correo.
# Puedes poner varios separados por coma: ana@gmail.com,luis@outlook.com
ALERTA_EMAIL_DESTINATARIOS=tu_correo@ejemplo.com

# Cómo se envían:
#   consola  -> no se envía nada; el correo se imprime en la terminal de
#               runserver. Sirve para probar sin configurar nada más.
#   sendgrid -> por SendGrid (llena la sección A).
#   smtp     -> por Gmail, Outlook u otro servidor SMTP (llena la sección B).
ALERTA_EMAIL_PROVEEDOR=consola

# --- A. SendGrid ---
# API key con permiso "Mail Send" (empieza con SG.).
SENDGRID_API_KEY=
# REMITENTE: el correo que verificaste en SendGrid como "Single Sender".
# NO es el correo de quien recibe: si lo cambias por otro que no esté
# verificado en tu cuenta de SendGrid, los correos no salen (error 403).
SENDGRID_FROM_EMAIL=

# --- B. SMTP (ejemplo para Gmail con "contraseña de aplicación") ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

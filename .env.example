# CoffeeStock - configuración local
# Qué poner aquí según tu caso: README.md, paso 4.

# ===== BASE DE DATOS =====
DB_NAME=CoffeeStockDB
# Igual al "Server name" de SQL Server Management Studio
DB_HOST=localhost\SQLEXPRESS
DB_PORT=
# Vacíos = entrar con tu usuario de Windows
DB_USER=
DB_PASSWORD=

# ===== ALERTAS POR CORREO =====
# consola = las alertas se ven en la terminal, no se envían
ALERTA_EMAIL_PROVEEDOR=consola
ALERTA_EMAIL_DESTINATARIOS=tu_correo@gmail.com

# ===== DATOS DEL NEGOCIO (tickets y reportes) =====
NEGOCIO_NOMBRE=CoffeeStock Café
NEGOCIO_DIRECCION=San Salvador, El Salvador
NEGOCIO_TELEFONO=
NEGOCIO_NIT=
TIME_ZONE=America/El_Salvador

# ===== MODO PRODUCCIÓN (opcional) =====
# Para la presentación o el uso real. Con DEBUG=False hay que poner una
# SECRET_KEY propia y correr una vez: python manage.py collectstatic
# DEBUG=False
# SECRET_KEY=pon-aqui-una-frase-larga-y-secreta
# ALLOWED_HOSTS=localhost,127.0.0.1
